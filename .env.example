# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database
# DB_CLIENT selects the dialect: 'sqlite' (default) or 'postgres'.
DB_CLIENT=sqlite
DB_PATH=./data/health-check.db
# Required when DB_CLIENT=postgres, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET=your-32-char-jwt-secret-here-change-me
JWT_EXPIRES_IN=7d

# Editable AI prompts — plain files a human can git diff/commit on the host;
# edits made via AI Settings > Prompts write to these same files. Defaults to
# ./prompts (resolved relative to the backend process's cwd, which is
# `backend/` for both `npm run dev` and the Docker image's WORKDIR). Seeded on
# boot from backend/src/ai/prompt-defaults if missing. In Docker Compose this
# is mounted to ./backend/prompts on the host (see docker-compose.yaml).
PROMPTS_DIR=./prompts

# Encryption (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-char-encryption-key-here-change-me

# AI Provider (optional - one of: openai, anthropic, none)
AI_PROVIDER=ollama

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic / Claude (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Ollama - local inference, no API key needed (if AI_PROVIDER=ollama)
# Start Ollama: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# HTTPS (optional) - serves the backend (and, in standalone mode, the Vite
# dev server) over HTTPS instead of plain HTTP. A self-signed cert is
# generated automatically on first start if SSL_CERT_PATH/SSL_KEY_PATH don't
# already exist — browsers will warn about it, which is expected for local
# HTTPS. In Docker mode, TLS is instead terminated at the frontend nginx
# container; see docker-compose.https.yaml.
HTTPS_ENABLED=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# CORS (frontend URL) - use https:// here too if HTTPS_ENABLED=true
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Datadog collection timeouts & pagination limits
DATADOG_REQUEST_TIMEOUT_MS=30000
DATADOG_MAX_RETRIES=3
DATADOG_MAX_PAGES_HOSTS=1000
DATADOG_MAX_PAGES_SERVICES=100
DATADOG_MAX_PAGES_EVENTS=20

# OpenBao - decrypts any ENC[...] value below before the app reads it (see backend/src/utils/secrets.ts)
BAO_ADDR=https://127.0.0.1:8200
BAO_NAMESPACE=datadog
BAO_CACERT=/path/to/openbao/certs/ca.pem
BAO_USERNAME=
BAO_PASSWORD=

# Datadog org credentials for the app itself are entered per-org via the UI
# (Org Connections) and stored encrypted in the database — never read from
# environment variables, so they don't belong here.
#
# DD_API_KEY/DD_APP_KEY below are a *separate* pair, only needed if you run
# the optional Datadog Agent container (docker-compose.observability.yaml /
# `scripts/deploy.sh --observability`) — the Agent itself needs them to
# report host metrics. Leave blank otherwise. Accepts a plain value or an
# OpenBao ENC[vault:v1:...] ciphertext (see the OpenBao section above).
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# Datadog APM / tracing (backend)
# Requires a Datadog Agent running — https://docs.datadoghq.com/agent/
# DD_TRACE_ENABLED is read directly by dd-trace itself (not app code) — set
# to false to disable tracing without an Agent running.
DD_TRACE_ENABLED=false
DD_SERVICE=dd-health-check-api
DD_ENV=development
DD_VERSION=1.0.0
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8136
DD_DOGSTATSD_PORT=8125

# Datadog RUM + Logs + Session Replay (frontend)
# Create a Browser application at: Datadog > UX Monitoring > Setup & Configurations > New Application
# VITE_ prefix exposes vars to the browser bundle — client tokens are safe to commit
VITE_DD_RUM_APP_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_SERVICE=dd-health-check-ui
VITE_DD_ENV=development
VITE_DD_VERSION=1.0.0
VITE_DD_SITE=datadoghq.com
